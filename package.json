{
  "name": "yyc3-cli",
  "version": "2.1.0",
  "description": "YYC³ 命令行界面 - 言启象限 | 语枢未来 | 万象归元于云枢 | 深栈智启新纪元",
  "main": "lib/index.js",
  "bin": {
    "yyc3": "bin/yyc3-cli.js"
  },
  "scripts": {
    "start": "node bin/yyc3-cli.js",
    "dev": "nodemon bin/yyc3-cli.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration",
    "lint": "eslint bin lib --ext .js",
    "lint:fix": "eslint bin lib --ext .js --fix",
    "format": "prettier --write \"**/*.{js,md,json}\"",
    "build": "echo \"CLI tool - no build required\"",
    "audit": "npm audit --audit-level=high",
    "release": "standard-version",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "figlet": "^1.12.0",
    "glob": "^14.0.3",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "standard-version": "^9.5.0"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "brace-expansion": "5.0.12",
    "browserslist": "^4.29.5",
    "js-yaml": "^4.3.2",
    "baseline-browser-mapping": ">=2.11.0",
    "@eslint-community/eslint-utils": "^4.0.0"
  },
  "keywords": [
    "yyc3",
    "cli",
    "management",
    "ai",
    "devops",
    "cloud",
    "automation"
  ],
  "author": "YYC³ Team <team@yyc3.com>",
  "contributors": [
    "YYC³ Core Team"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YYC-Cube/YYC3-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-CLI/issues"
  },
  "homepage": "https://github.com/YYC-Cube/YYC3-CLI",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
